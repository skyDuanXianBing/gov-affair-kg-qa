{
  "version": 1,
  "source_manifest": "schema/openspg_import_manifest.json",
  "target_mib": 128,
  "hard_file_limit_mib": 200,
  "output_dir": "build/openspg-shards",
  "state_file": "build/openspg-import-state.json",
  "min_free_gib": 15,
  "group_order": [
    "entities",
    "relations",
    "documents"
  ],
  "rolling": {
    "enabled": true,
    "max_local_parts_per_job": 1,
    "delete_after_success": true,
    "require_wait_for_delete": true,
    "resume_by_sha256": true
  },
  "status": "ready"
}
