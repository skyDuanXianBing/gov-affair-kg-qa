namespace ZwdmxGJ

# 用途：政务服务事项的确定性图谱 + KAG 文本检索。
# 主键不在 schema 中声明；导入时将各 CSV 的 *_id 字段映射为实体业务 ID。

Chunk(文本块): EntityType
    properties:
        description(描述): Text
        name(名称): Text
        content(内容): Text
            index: TextAndVector
        docId(文档ID): Text
            index: Text
        serviceId(事项ID): Text
            index: Text
        departmentName(主管部门名称): Text
            index: Text
        categoryL1(一级分类): Text
            index: Text
        categoryL2(二级分类): Text
            index: Text
        domainId(领域ID): Text
            index: Text
        categoryId(分类ID): Text
            index: Text
        modelId(知识模型ID): Text
            index: Text
        sourceUrl(来源链接): Text
        sourceFile(来源文件): Text
        sourceLine(来源行号): Text

GovernmentService(政务事项): EntityType
    properties:
        description(描述): Text
        name(事项名称): Text
            index: Text
        serviceId(事项ID): Text
            index: Text
        categoryL1(一级分类): Text
            index: Text
        categoryL2(二级分类): Text
            index: Text
        domainId(领域ID): Text
            index: Text
        categoryId(分类ID): Text
            index: Text
        modelId(知识模型ID): Text
            index: Text
        departmentName(主管部门名称): Text
            index: Text
        departmentCode(主管部门编码): Text
            index: Text
        sourceUrl(来源链接): Text
        sourceFile(来源文件): Text
        sourceLine(来源行号): Text
        publishDate(发布日期): Text
        versionDate(版本日期): Text
        datasetScope(数据集范围): Text
            index: Text
        serviceObject(服务对象): Text
            index: Text
        exerciseLevel(行使层级): Text
            index: Text
        serviceStatus(状态): Text
            index: Text
        onlineDepth(网上办理深度): Text
        onlineAvailable(可网上办理): Text
        promiseTimeLimit(承诺办结时限): Text
        legalTimeLimit(法定办结时限): Text
        officialListCount(官方列表出现次数): Integer
        detailReturnCode(详情返回编码): Text
        sourceRecordSha256(结构化记录SHA256): Text
        officialJsonSha256(官方详情JSON SHA256): Text
    relations:
        handledBy(主管部门): Department
            properties:
                departmentRole(部门角色): Text
        collaboratesWith(协同部门): Department
            properties:
                participatesInStep(参与步骤): Text
        requiresMaterial(需要材料): Material
            properties:
                required(是否必要): Text
                orderNo(材料顺序): Integer
                materialDescription(材料说明): Text
                acceptanceStandard(受理标准): Text
        hasCondition(办理条件): ServiceCondition
            properties:
                conditionSource(条件来源): Text
        hasProcessStep(办理步骤): ProcessStep
            properties:
                orderNo(步骤顺序): Integer
        producesResult(办理结果): ServiceResult
            properties:
                orderNo(结果顺序): Integer
        basedOn(政策依据): LegalBasis
            properties:
                orderNo(依据顺序): Integer
                basisSource(依据来源): Text
        hasFaq(常见问答): FAQ
            properties:
                orderNo(问答顺序): Integer
        hasChannel(办理渠道): ServiceChannel
        hasFee(收费信息): Fee
        belongsToDomain(所属领域): ServiceDomain
        classifiedAs(所属分类): ServiceCategory
        usesModel(使用知识模型): KnowledgeModel

Department(部门): EntityType
    properties:
        description(描述): Text
        name(部门名称): Text
            index: Text
        departmentId(部门ID): Text
            index: Text
        departmentCode(部门编码): Text
            index: Text

Material(申请材料): EntityType
    properties:
        description(描述): Text
        name(材料名称): Text
            index: Text
        materialId(材料ID): Text
            index: Text
        materialType(材料类型): Text
            index: Text
        sourceType(材料来源类型): Text
        submissionFormat(提交形式): Text

ServiceCondition(办理条件): EntityType
    properties:
        description(条件内容): Text
            index: Text
        name(条件名称): Text
            index: Text
        conditionId(条件ID): Text
            index: Text

ProcessStep(办理步骤): EntityType
    properties:
        description(步骤结果): Text
        name(步骤名称): Text
            index: Text
        processStepId(步骤ID): Text
            index: Text
        stepCode(步骤编码): Text
        handler(办理人员或机构): Text
            index: Text
        timeLimit(步骤时限): Text
        checkStandard(核验标准): Text
    relations:
        nextStep(下一步骤): ProcessStep

ServiceResult(办理结果): EntityType
    properties:
        description(结果说明): Text
        name(结果名称): Text
            index: Text
        resultId(结果ID): Text
            index: Text
        resultType(结果类型): Text
            index: Text
        licenseCode(证照编码): Text
        validityPeriod(有效期): Text

LegalBasis(法律依据): EntityType
    properties:
        description(条文内容): Text
            index: Text
        name(法律法规名称): Text
            index: Text
        legalBasisId(法律依据ID): Text
            index: Text
        article(条款): Text
            index: Text
        documentNumber(文号): Text
        publishedDate(发布日期): Text
        lawUrl(法规链接): Text

FAQ(常见问答): EntityType
    properties:
        description(答案): Text
            index: Text
        name(问题): Text
            index: Text
        faqId(问答ID): Text
            index: Text
        answer(答案): Text
            index: Text

ServiceChannel(办理渠道): EntityType
    properties:
        description(渠道说明): Text
        name(渠道内容): Text
            index: Text
        channelId(渠道ID): Text
            index: Text
        channelType(渠道类型): Text
            index: Text
        serviceTime(服务时间): Text

Fee(收费信息): EntityType
    properties:
        description(收费依据): Text
        name(收费项目): Text
            index: Text
        feeId(收费ID): Text
            index: Text
        feeStandard(收费标准): Text
        feeStatus(收费状态): Text

ServiceDomain(服务领域): EntityType
    properties:
        description(领域说明): Text
        name(领域名称): Text
            index: Text
        domainId(领域ID): Text
            index: Text
        status(状态): Text
            index: Text
        version(版本): Text

CategoryScheme(分类体系): EntityType
    properties:
        description(体系说明): Text
        name(体系名称): Text
            index: Text
        schemeId(体系ID): Text
            index: Text
        domainId(领域ID): Text
            index: Text
        version(版本): Text

ServiceCategory(服务分类): EntityType
    properties:
        description(分类说明): Text
        name(分类名称): Text
            index: Text
        categoryId(分类ID): Text
            index: Text
        categoryLevel(分类层级): Integer
        parentCategoryId(父分类ID): Text
            index: Text
        schemeId(分类体系ID): Text
            index: Text
        domainId(领域ID): Text
            index: Text
        status(状态): Text
            index: Text
        version(版本): Text
    relations:
        parentCategory(父分类): ServiceCategory
        belongsToScheme(所属分类体系): CategoryScheme
        belongsToDomain(所属领域): ServiceDomain

KnowledgeModel(知识模型): EntityType
    properties:
        description(模型说明): Text
        name(模型名称): Text
            index: Text
        modelId(模型ID): Text
            index: Text
        modelType(模型类型): Text
            index: Text
        domainId(领域ID): Text
            index: Text
        categoryId(分类ID): Text
            index: Text
        version(版本): Text
        schemaVersion(Schema版本): Text
        enabledEntityTypes(启用实体类型): Text
        enabledRelationTypes(启用关系类型): Text
        retrievalFilter(检索过滤配置): Text
        validationProfile(校验规则配置): Text
        status(状态): Text
            index: Text
    relations:
        appliesToCategory(适用分类): ServiceCategory
        belongsToDomain(所属领域): ServiceDomain
        extendsModel(继承模型): KnowledgeModel
